{
  "manifest_version": 3,
  "name": "Chief of Staff for WhatsApp",
  "version": "1.9.0",
  "description": "Reads WhatsApp for your Chief of Staff (never clicks, opens chats or sends there). Optional computer helper, off until you switch it on, that does jobs you ask for in its own window.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://chief-of-staff.gremiercoffee.workers.dev/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "reader.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Chief of Staff for WhatsApp",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
