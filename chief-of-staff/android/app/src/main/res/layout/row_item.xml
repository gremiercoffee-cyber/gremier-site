<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="44dp">
    <TextView
        android:id="@+id/check"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="○"
        android:textSize="20sp"
        android:textColor="@color/muted" />
    <LinearLayout
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/item_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <!-- Shown when the Chief of Staff wasn't sure of the area -->
        <LinearLayout
            android:id="@+id/ask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Which area?" android:textSize="11sp" android:textColor="@color/accent" android:paddingEnd="6dp" />
            <TextView android:id="@+id/cat_coffee" android:layout_width="wrap_content" android:layout_height="26dp"
                android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:layout_marginEnd="4dp"
                android:background="@drawable/pill" android:text="☕ Coffee" android:textSize="11sp" android:textColor="@color/ink" />
            <TextView android:id="@+id/cat_yeshiva" android:layout_width="wrap_content" android:layout_height="26dp"
                android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:layout_marginEnd="4dp"
                android:background="@drawable/pill" android:text="📚 Yeshiva" android:textSize="11sp" android:textColor="@color/ink" />
            <TextView android:id="@+id/cat_personal" android:layout_width="wrap_content" android:layout_height="26dp"
                android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp"
                android:background="@drawable/pill" android:text="🏠 Personal" android:textSize="11sp" android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
