<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp">
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chief of Staff"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:fontFamily="serif" />
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading…"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <TextView
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="↻"
            android:textSize="16sp"
            android:textColor="@color/muted" />
        <TextView
            android:id="@+id/add"
            android:layout_width="32dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="+"
            android:textSize="20sp"
            android:textColor="@color/muted" />
        <TextView
            android:id="@+id/talk"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:background="@drawable/pill"
            android:text="🎙 Talk"
            android:textSize="13sp"
            android:textColor="@color/accent" />
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/tab0" android:layout_width="wrap_content" android:layout_height="28dp"
            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:textSize="12sp" android:text="To do" />
        <TextView android:id="@+id/tab1" android:layout_width="wrap_content" android:layout_height="28dp"
            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:textSize="12sp" android:text="People" />
        <TextView android:id="@+id/tab2" android:layout_width="wrap_content" android:layout_height="28dp"
            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:textSize="12sp" android:text="Calendar" />
        <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/prev" android:layout_width="30dp" android:layout_height="28dp"
            android:gravity="center" android:text="‹" android:textSize="18sp" android:textColor="@color/muted" />
        <TextView android:id="@+id/next" android:layout_width="30dp" android:layout_height="28dp"
            android:gravity="center" android:text="›" android:textSize="18sp" android:textColor="@color/muted" />
    </LinearLayout>

    <!-- Area filter (To do / People) -->
    <LinearLayout
        android:id="@+id/filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/f_all" android:layout_width="wrap_content" android:layout_height="24dp"
            android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:layout_marginEnd="4dp"
            android:textSize="11sp" android:text="All" />
        <TextView android:id="@+id/f_coffee" android:layout_width="wrap_content" android:layout_height="24dp"
            android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:layout_marginEnd="4dp"
            android:textSize="11sp" android:text="☕ Coffee" />
        <TextView android:id="@+id/f_yeshiva" android:layout_width="wrap_content" android:layout_height="24dp"
            android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:layout_marginEnd="4dp"
            android:textSize="11sp" android:text="📚 Yeshiva" />
        <TextView android:id="@+id/f_personal" android:layout_width="wrap_content" android:layout_height="24dp"
            android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:textSize="11sp" android:text="🏠 Personal" />
    </LinearLayout>

    <!-- To do / People -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:divider="@null"
        android:scrollbars="none" />

    <!-- Calendar: three day columns -->
    <LinearLayout
        android:id="@+id/cal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
            <TextView android:id="@+id/day0_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="true" android:letterSpacing="0.1" android:textSize="10sp" android:textColor="@color/muted" android:paddingStart="2dp" android:paddingBottom="3dp" />
            <ListView android:id="@+id/day0" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:scrollbars="none" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
            <TextView android:id="@+id/day1_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="true" android:letterSpacing="0.1" android:textSize="10sp" android:textColor="@color/muted" android:paddingStart="2dp" android:paddingBottom="3dp" />
            <ListView android:id="@+id/day1" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:scrollbars="none" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/day2_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="true" android:letterSpacing="0.1" android:textSize="10sp" android:textColor="@color/muted" android:paddingStart="2dp" android:paddingBottom="3dp" />
            <ListView android:id="@+id/day2" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="All clear ✨"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
