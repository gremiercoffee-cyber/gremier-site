<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/prev" android:layout_width="22dp" android:layout_height="match_parent"
            android:gravity="center" android:text="‹" android:textSize="22sp" android:textColor="#8A8178" />
        <LinearLayout android:id="@+id/b0" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/btn_bg">
            <TextView android:id="@+id/b0_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" />
            <TextView android:id="@+id/b0_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#1A1A1A" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/b0_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="#8A8178" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/btn_bg">
            <TextView android:id="@+id/b1_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" />
            <TextView android:id="@+id/b1_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#1A1A1A" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/b1_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="#8A8178" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/btn_bg">
            <TextView android:id="@+id/b2_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" />
            <TextView android:id="@+id/b2_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#1A1A1A" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/b2_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="#8A8178" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/btn_bg">
            <TextView android:id="@+id/b3_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" />
            <TextView android:id="@+id/b3_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#1A1A1A" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/b3_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="#8A8178" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/next" android:layout_width="22dp" android:layout_height="match_parent"
            android:gravity="center" android:text="›" android:textSize="22sp" android:textColor="#8A8178" />
    </LinearLayout>
    <TextView android:id="@+id/dots" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="8sp" android:textColor="#8A8178" android:text="● ○" />
</LinearLayout>
