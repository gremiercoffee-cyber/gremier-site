#!/usr/bin/env bash
# Run the Supabase CLI against the Gremier project using a personal access token
# instead of the shared `supabase login` session — that session gets overwritten
# whenever another project on this machine logs in, which repeatedly broke deploys.
#
# Setup (once): create a token at https://supabase.com/dashboard/account/tokens
# while signed in as the Gremier account, then save it to the file below.
# The file lives OUTSIDE the repo so it can never be committed.
#
# Usage:  ./scripts/sb functions deploy create-payment
#         ./scripts/sb db push
set -euo pipefail

TOKEN_FILE="${SUPABASE_TOKEN_FILE:-$HOME/.gremier-supabase-token}"

if [ ! -f "$TOKEN_FILE" ]; then
  echo "No Supabase token found at: $TOKEN_FILE" >&2
  echo "Create one at https://supabase.com/dashboard/account/tokens (as the Gremier account)," >&2
  echo "then save just the token (starts with sbp_) into that file." >&2
  exit 1
fi

SUPABASE_ACCESS_TOKEN="$(tr -d ' \t\r\n' < "$TOKEN_FILE")"
export SUPABASE_ACCESS_TOKEN

if [ -z "$SUPABASE_ACCESS_TOKEN" ]; then
  echo "Token file $TOKEN_FILE is empty." >&2
  exit 1
fi

cd "$(dirname "$0")/.."
exec npx supabase "$@"
